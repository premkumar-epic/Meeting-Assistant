    "text": "Vahagul me kutun bana darava"
  },
  {
    "id": 17,
    "start": 89.18,
    "end": 93.42,
    "text": "Tu asudi ra vee me asa darava"
  },
  {
    "id": 18,
    "start": 93.42,
    "end": 95.48,
    "text": "Denyutak darava"
  },
  {
    "id": 19,
    "start": 123.14,
    "end": 141.98,
    "text": "\u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d\u0937 \u092a\u0941\u092a\u094d"
  },
  {
    "id": 20,
    "start": 140.0,
    "end": 144.62,
    "text": "Raji bharang kadi tu hemari"
  },
  {
    "id": 21,
    "start": 144.62,
    "end": 148.46,
    "text": "La gai ala gai jahanadi"
  },
  {
    "id": 22,
    "start": 148.46,
    "end": 152.84,
    "text": "It's a nasirana zirana zirana adi gala veu"
  },
  {
    "id": 23,
    "start": 152.84,
    "end": 155.84,
    "text": "Tu bhi sun la zirana"
  },
  {
    "id": 24,
    "start": 155.84,
    "end": 160.3,
    "text": "My tato litte re re rela"
  },
  {
    "id": 25,
    "start": 160.3,
    "end": 164.86,
    "text": "My tato litte re re rela"
  },
  {
    "id": 26,
    "start": 164.86,
    "end": 169.98,
    "text": "My tato litte re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re re"
  },
  {
    "id": 27,
    "start": 168.0,
    "end": 173.52,
    "text": "..or lakkiree.."
  },
  {
    "id": 28,
    "start": 173.52,
    "end": 176.12,
    "text": "..Inapeka lira vah.."
  },
  {
    "id": 29,
    "start": 176.12,
    "end": 180.44,
    "text": "..Inapeka lira vah.."
  },
  {
    "id": 30,
